% Keep long tables aligned with the text block and leave compact, predictable
% whitespace around them.  Individual tables provide their own repeated heads.
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{0.6em}
\setlength{\LTpost}{0.6em}

% A source note in a longtable must be a row so that it remains attached to the
% final page.  The first argument is the number of table columns.
\newcommand{\tableSourceRow}[2]{%
  \multicolumn{#1}{@{}p{\dimexpr\textwidth\relax}@{}}{\footnotesize\textit{Source: #2}}\\[-0.25ex]
}

\setlength{\parindent}{2.0em}
\setlength{\parskip}{0.5em}
\setlength{\emergencystretch}{3em}
\setlist[itemize]{leftmargin=*,itemsep=0.2em,topsep=0.25em}
\setlist[enumerate]{leftmargin=*,itemsep=0.2em,topsep=0.25em}

\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\Large\bfseries\color{deepblue}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\color{teal}}{\thesubsection}{0.7em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\color{deepblue}}{\thesubsubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{1.5ex plus .4ex minus .2ex}{0.8ex}
\titlespacing*{\subsection}{0pt}{1.2ex plus .3ex minus .2ex}{0.5ex}
\titlespacing*{\subsubsection}{0pt}{1ex plus .2ex minus .1ex}{0.3ex}

